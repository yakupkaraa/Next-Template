# Ortam: development | qa | production (next.config / lib/config.ts tarafından okunur)
NEXT_PUBLIC_APP_ENV=development

# Backend API taban URL'si (lib/config.ts; verilmezse ortam bazlı fallback kullanılır)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Metadata (metadataBase) için mutlak site URL'si (opsiyonel; verilmezse Vercel'in
# VERCEL_PROJECT_PRODUCTION_URL'i, o da yoksa http://localhost:3000 kullanılır)
# NEXT_PUBLIC_SITE_URL=https://example.com
